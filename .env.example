# --- Neon (Projekt → Connect). Region: AWS Europe Central 1 (Frankfurt) ---
# Pooled Connection String (Hostname mit "-pooler")
DATABASE_URL=postgresql://neondb_owner:<passwort>@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direkte Verbindung für Migrationen (ohne "-pooler")
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<passwort>@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Better Auth ---
# Zufälliger Wert, mind. 32 Zeichen:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PLATFORM_ADMIN_EMAIL=apps@alw-mediaworks.de

# --- E-Mail (Resend). Ohne Key werden Mails nur in der Konsole ausgegeben. ---
RESEND_API_KEY=
MAIL_FROM="juna <noreply@juna.app>"

# --- Dateien (Vercel Blob, PRIVATER Store). Wird von Vercel beim Verbinden des Stores gesetzt. ---
BLOB_READ_WRITE_TOKEN=
# Lokal ohne Blob: Dateien in einem Ordner ablegen (nur Entwicklung/Tests, max. 5 MB pro Datei)
# JUNA_LOCAL_STORAGE_DIR=./.juna-files

# --- Gemeinsames Bearbeiten in Echtzeit (Liveblocks → Dashboard → API keys → Secret key) ---
# Ohne Key: Notizen/Protokoll werden normal gespeichert, mit Konflikterkennung statt Live-Bearbeitung.
LIVEBLOCKS_SECRET_KEY=

# --- Nur für RLS-Tests (leere Test-Datenbank, NIE Produktion – z. B. ein Neon-Branch) ---
# TEST_DATABASE_URL=postgresql://...
